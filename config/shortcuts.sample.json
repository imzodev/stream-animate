{
  "version": "1.5.0",
  "shortcuts": [
    {"hotkey": "<ctrl>+<alt>+1", "sound": "assets/sounds/sample.wav"},
    {"hotkey": "<ctrl>+<alt>+2", "overlay": {"file": "assets/overlays/sample.mp4", "x": 800, "y": 450, "duration": 0}},

    {"suffix": "b", "overlay": {"file": "assets/overlays/sample.gif", "x": 960, "y": 540, "duration": 1500}},
    {"suffix": ["g", "h"], "sound": "assets/sounds/sample2.mp3"},

    {"hotkey": "<ctrl>+<alt>+q", "fact_check": true}
  ],
  "activator": {"hotkey": "<ctrl>+<alt>+a", "mode": "press", "timeout_ms": 1500},
  "stt": {
    "enabled": false,
    "always_on": false,
    "hotkey": "<ctrl>+<alt>+space",
    "language": "auto",
    "model": "turbo",
    "device": null,
    "chunk_seconds": 4.0,
    "sample_rate": 16000,
    "append_space": true,
    "silence_rms_threshold": 0.005,
    "dedup_window": 64,
    "trigger_cooldown_ms": 1500,
    "type_into_focused_window": true,
    "voice_triggers_enabled": true
  },
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "api_key_env": "LLM_API_KEY",
    "persona": "fact_checker",
    "system_prompt": null,
    "temperature": 0.3,
    "max_tokens": 512,
    "toggle_hotkey": "<ctrl>+<alt>+q",
    "timeout_seconds": 30,
    "silence_timeout": 5.0,
    "esc_hotkey": "<esc>"
  },
  "voice_commands": {
    "enabled": true,
    "wake_words": ["computadora", "compu"],
    "dictation_editing": true,
    "ai_fallback": false,
    "commands": [
      {"phrases": ["guarda", "guardar"], "actions": [{"type": "keys", "keys": "<ctrl>+s"}]},
      {"phrases": ["copia", "copiar"], "actions": [{"type": "keys", "keys": "<ctrl>+c"}]},
      {"phrases": ["pega", "pegar"], "actions": [{"type": "keys", "keys": "<ctrl>+v"}]},
      {"phrases": ["deshaz", "deshacer"], "actions": [{"type": "keys", "keys": "<ctrl>+z"}]},
      {"phrases": ["nueva pestana"], "actions": [{"type": "keys", "keys": "<ctrl>+t"}]},
      {"phrases": ["cierra la pestana", "cerrar pestana"], "actions": [{"type": "keys", "keys": "<ctrl>+w"}]},
      {"phrases": ["siguiente cancion"], "actions": [{"type": "media", "key": "next"}]},
      {"phrases": ["cancion anterior"], "actions": [{"type": "media", "key": "previous"}]},
      {"phrases": ["pausa", "reproduce", "play"], "actions": [{"type": "media", "key": "play_pause"}]},
      {"phrases": ["sube el volumen", "sube volumen"], "actions": [{"type": "media", "key": "volume_up"}]},
      {"phrases": ["baja el volumen", "baja volumen"], "actions": [{"type": "media", "key": "volume_down"}]},
      {"phrases": ["silencio", "mute"], "actions": [{"type": "media", "key": "mute"}]},
      {"phrases": ["abre youtube"], "actions": [{"type": "open", "target": "https://www.youtube.com"}]},
      {"phrases": ["terminal {name}", "ve a la terminal {name}"], "actions": [{"type": "switch_tab", "app": "terminal", "tab": "{name}"}]},
      {"phrases": ["pestana {name}", "ve a la pestana {name}"], "actions": [{"type": "switch_tab", "app": "browser", "tab": "{name}"}]},
      {"phrases": ["ve a {name}", "cambia a {name}"], "actions": [{"type": "focus_window", "title": "{name}"}]},
      {"phrases": ["dicta en {name}", "escribe en {name}"], "actions": [{"type": "focus_window", "title": "{name}"}, {"type": "wait", "ms": 150}, {"type": "dictation", "state": "on"}]},
      {"phrases": ["empieza a dictar", "dicta aqui"], "actions": [{"type": "dictation", "state": "on"}]}
    ]
  }
}
